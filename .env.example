# Copy one of the preset files below or point the backend at one with:
#   APP_ENV_FILE=.env.mock

APP_DEFAULT_MODEL_ID=mock_static
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_VLLM_BASE_URL=http://localhost:8002/v1
APP_VLLM_API_KEY=local
APP_LLAMACPP_BASE_URL=http://localhost:8001/v1
APP_LLAMACPP_API_KEY=local
APP_TRANSFORMERS_DEVICE=cpu
APP_TRANSFORMERS_MAX_NEW_TOKENS=192
APP_TRAINING_SERVICE_URL=http://localhost:15000
APP_MOCK_DELAY_MS=0
APP_PLATFORM_DB_PATH=/tmp/cognitive_agentic_platform_v6_platform/platform.db
APP_AGENT_MEMORY_DB_PATH=/tmp/cognitive_agentic_platform_v6_platform/agent_memory.db
APP_AGENT_MEMORY_TOP_K=5
APP_AGENT_MEMORY_SEMANTIC_WEIGHT=0.5
APP_AGENT_MEMORY_RECENCY_WEIGHT=0.2
APP_AGENT_MEMORY_IMPORTANCE_WEIGHT=0.2
APP_AGENT_MEMORY_CONVERSATION_WEIGHT=0.1
APP_AGENT_MAX_RECURSION_DEPTH=4
APP_AGENT_MAX_ITERATIONS=4
APP_AGENT_MAX_TOOL_CALLS=8
APP_AGENT_MAX_PROMPT_TOKENS=6000
APP_AGENT_MAX_TOTAL_TOKENS=10000
APP_AGENT_TOOL_ALLOWLIST=dataset_registry,benchmark_notes,training_notes,reasoning
APP_AGENT_BLOCK_PATTERNS=ignore previous instructions,delete memory,rm -rf
